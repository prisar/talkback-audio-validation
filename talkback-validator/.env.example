# TalkBack audio validation -- tester configuration
#
# Copy this file to .env in the talkback-validator directory, then run:
#   ./run-demo.sh
#
# .env is git-ignored. Do not commit it and do not paste it into a ticket,
# a chat channel, or a screen share: the key below bills to our account and
# anyone holding it can spend against it.

# ---------------------------------------------------------------------------
# Cloud transcription (Gemini). Needed only for the default backend.
# Leave this blank to run entirely on local models -- see LOCAL MODELS below.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=paste-the-key-here

# Which Gemini model answers. Stay on a -lite model: the free tier allows
# 20 requests per DAY on gemini-flash-latest, and one run spends about a
# dozen, so a second run that day fails with a quota error, not a key error.
TBV_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# LOCAL MODELS -- nothing leaves this machine
#
# Set TBV_BACKEND=whisper to transcribe on-device instead of in the cloud.
# Speech runs through Whisper; the screen is read by a local vision model
# when one is installed, and by tesseract otherwise.
#
# Install models from the dashboard's Models panel, or:
#   uv run talkback-validator models list
#   uv run talkback-validator models install gemma3:4b
#
# A run whose audio and screen backends are both local is executed behind a
# loopback-only network guard: any attempt to leave the machine raises rather
# than silently succeeding. GEMINI_API_KEY is not read on that path.
# ---------------------------------------------------------------------------
TBV_BACKEND=gemini

# Whisper size. tiny.en is fast and misreads digits; small.en is the default
# because it read every field correctly on the reference run.
TBV_WHISPER_MODEL=small.en

# Where the local model runtime is installed. Delete this directory to
# remove local inference entirely.
TBV_RUNTIME_DIR=.runtime

# Loopback port for the local model server. Only changed if 11435 is taken.
TBV_OLLAMA_PORT=11435
